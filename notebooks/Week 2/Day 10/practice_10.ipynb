    "        return \"bhau bhau\"\n",
    "\n",
    "class Cat(Animal):\n",
    "    def speak(self):\n",
    "        return \"meonwwwww\"\n",
    "\n",
    "\n",
    "ob1 = Dog()\n",
    "\n",
    "print(ob1.speak())\n",
    "\n",
    "ob1 = Cat()\n",
    "\n",
    "print(ob1.speak())\n"
   ]
